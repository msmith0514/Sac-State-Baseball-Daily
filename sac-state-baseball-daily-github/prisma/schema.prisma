generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlayerLevel {
  SAC_STATE
  MLB
  AAA
  AA
  HIGH_A
  LOW_A
  ROOKIE
  OTHER_PRO
  ALUMNI_INACTIVE
}

model Player {
  id                    String              @id @default(cuid())
  firstName             String
  lastName              String
  slug                  String              @unique
  position              String
  headshotUrl           String?
  sacramentoStateSeasons String
  hometown              String?
  draftInfo             String?
  currentOrganization   String?
  currentLevel          PlayerLevel
  isCurrentSacState     Boolean             @default(false)
  externalIds           ExternalPlayerId[]
  performances          PlayerPerformance[]
  articleLinks          ArticlePlayer[]
  videoLinks            VideoPlayer[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([lastName, firstName])
  @@index([currentLevel])
}

model ExternalPlayerId {
  id         String @id @default(cuid())
  playerId   String
  provider   String
  externalId String
  player     Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([playerId, provider])
}

model Game {
  id              String              @id @default(cuid())
  externalGameId  String
  provider        String
  gameDate        DateTime
  team            String
  opponent        String
  teamScore       Int?
  opponentScore   Int?
  result             String?
  status             String
  scheduledStartAt   DateTime?
  liveDetail         String?
  watchLabel         String?
  watchUrl           String?
  broadcastSourceUrl String?
  statusFetchedAt    DateTime?
  sourceUrl          String?
  sourceFetchedAt    DateTime?
  performances       PlayerPerformance[]

  @@unique([provider, externalGameId])
  @@index([gameDate])
}

model PlayerPerformance {
  id               String  @id @default(cuid())
  playerId         String
  gameId           String
  appeared         Boolean @default(true)
  battingJson      Json?
  pitchingJson     Json?
  performanceScore Float?
  sourceProvider   String
  sourceUrl        String?
  sourceFetchedAt  DateTime
  player           Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  game             Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([playerId, gameId])
  @@index([performanceScore])
}

model SeasonStat {
  id              String   @id @default(cuid())
  playerId        String
  season          Int
  level           String
  statType        String
  statsJson       Json
  sourceProvider  String
  sourceUrl       String?
  sourceFetchedAt DateTime

  @@unique([playerId, season, level, statType, sourceProvider])
  @@index([playerId, season])
}

model Article {
  id              String          @id @default(cuid())
  title           String
  source          String
  url             String          @unique
  imageUrl        String?
  publishedAt     DateTime
  summary         String?
  sourceFetchedAt DateTime
  players         ArticlePlayer[]
  dailyPages      DailyArticle[]

  @@index([publishedAt])
}

model ArticlePlayer {
  articleId String
  playerId  String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  player    Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([articleId, playerId])
}

model Video {
  id              String        @id @default(cuid())
  title           String
  url             String        @unique
  embedUrl        String?
  thumbnailUrl    String?
  source          String
  gameDate        DateTime?
  sourceFetchedAt DateTime
  players         VideoPlayer[]
  dailyPages      DailyVideo[]
}

model VideoPlayer {
  videoId  String
  playerId String
  video    Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([videoId, playerId])
}

model DailyPage {
  id             String         @id @default(cuid())
  date           DateTime       @unique
  timezone       String
  headline       String?
  recap          String?
  playerOfDayId  String?
  generatedAt    DateTime
  sourceAuditJson Json
  articles       DailyArticle[]
  videos         DailyVideo[]
}

model DailyArticle {
  dailyPageId String
  articleId   String
  dailyPage   DailyPage @relation(fields: [dailyPageId], references: [id], onDelete: Cascade)
  article     Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([dailyPageId, articleId])
}

model DailyVideo {
  dailyPageId String
  videoId     String
  dailyPage   DailyPage @relation(fields: [dailyPageId], references: [id], onDelete: Cascade)
  video       Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([dailyPageId, videoId])
}
